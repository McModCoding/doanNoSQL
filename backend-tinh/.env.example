# Cấu hình backend của Trung Tính. Chép thành file .env rồi sửa nếu cần.
# CHAY-BACKEND-TINH.bat (hoặc npm run tao-env) tự chép và tự tạo JWT_SECRET ngẫu nhiên.
# Không bao giờ đưa file .env lên GitHub.

PORT=5000

# CSDL riêng của backend này. Không dùng CinemaLoyaltyDB: đó là CSDL demo của backend chính
# (thư mục backend/), cấu trúc document khác, dùng chung sẽ đè nhau.
MONGODB_URI=mongodb://127.0.0.1:27017/CinemaLoyaltyDB_Tinh

JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=1d

NODE_ENV=development
# Bật thanh toán giả lập (POST /api/thanh-toan/simulate), không gọi MoMo thật
DEV_PAYMENT_ENABLED=true

# Số tiền (đồng) cho 1 điểm gốc, trước khi cộng thưởng theo hạng
VND_PER_POINT=10000

# Chỉ cần khi thử cổng MoMo Sandbox thật (POST /api/thanh-toan). Để trống thì dùng giả lập ở trên.
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_REDIRECT_URL=
# MOMO_IPN_URL=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
